# Zathura configuration file
# Cyberpunk-inspired colors + JetBrains Mono Nerd Font

# Open document in fit-width mode by default
set adjust-open "best-fit"

# One page per row by default
set pages-per-row 1

# Scroll settings
set scroll-page-aware "true"
set smooth-scroll "true"
set scroll-full-overlap 0.01
set scroll-step 50

# Zoom settings
set zoom-min 10

# GUI options
set guioptions ""

# Font
set font "JetBrainsMono Nerd Font Mono 16"

# Colors (Cyberpunk theme)
set default-bg "#0a0a0a"        # background
set default-fg "#eaeaea"        # foreground

set statusbar-bg "#0a0a0a"
set statusbar-fg "#eaeaea"

set inputbar-bg "#0a0a0a"
set inputbar-fg "#eaeaea"

set notification-error-bg "#1a1a1a"
set notification-error-fg "#eaeaea"

set notification-warning-bg "#1a1a1a"
set notification-warning-fg "#eaeaea"

set highlight-color "#eaeaea"
set highlight-active-color "#ffffff"

set completion-bg "#0a0a0a"
set completion-fg "#eaeaea"
set completion-highlight-bg "#1a1a1a"
set completion-highlight-fg "#ffffff"

set notification-bg "#1a1a1a"
set notification-fg "#eaeaea"

# Recolor settings
set recolor "true"
set recolor-lightcolor "#0a0a0a"
set recolor-darkcolor "#eaeaea"
set recolor-reverse-video "true"
set recolor-keephue "true"

# Keybindings
unmap f
map f toggle_fullscreen
map [fullscreen] f toggle_fullscreen

