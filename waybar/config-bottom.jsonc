// -*- mode: jsonc -*-
{
    // "layer": "top", // Waybar at top layer
    "position": "bottom", // Waybar position (top|bottom|left|right)
    "height": 30, // Waybar height (to be removed for auto height)
    // "width": 1280, // Waybar width
    "spacing": 2, // Gaps between modules (4px)
    // Choose the order of the modules
    "margin": "0, 0, 0, 0",
    "modules-left": [
	"temperature",
	"pulseaudio",
	"network"
    ],
    "modules-center": [
        "tray"
    ],
    "modules-right": [
        //"mpd",
       // "idle_inhibitor",
        "power-profiles-daemon",
        "backlight",
        "battery"
       // "custom/power"
    ],
    // Modules configuration
    // "sway/workspaces": {
    //     "disable-scroll": true,
    //     "all-outputs": true,
    //     "warp-on-scroll": false,
    //     "format": "{name}: {icon}",
    //     "format-icons": {
    //         "1": "",
    //         "2": "",
    //         "3": "",
    //         "4": "",
    //         "5": "",
    //         "urgent": "",
    //         "focused": "",
    //         "default": ""
    //     }
    // },

    "tray": {
        "icon-size": 21,
        "spacing": 10,
        // "icons": {
        //   "blueman": "bluetooth",
        //   "TelegramDesktop": "$HOME/.local/share/icons/hicolor/16x16/apps/telegram.png"
        // }
    },
    "temperature": {
        //"thermal-zone": 2,
        // "hwmon-path": "/sys/class/hwmon/hwmon2/temp1_input",
        "critical-threshold": 80,
        // "format-critical": "{temperatureC}°C {icon}",
        "format": "[ {temperatureC}°C temp ]",
        "format-icons": ["", "", ""]
    },
    "backlight": {
        // "device": "acpi_video1",
        "format": "[ bl {percent}% ]",
    },
    "battery": {
        "states": {
            // "good": 95,
            "warning": 30,
            "critical": 15
        },
        "format": "[ {capacity}% bat ]",
        "format-full": "[ {capacity}% full ]",
        "format-charging": "[ {capacity}% chg ]",
        "format-plugged": "[ {capacity}% chg ]",
        // "format-good": "", // An empty format will hide the module
        // "format-full": "",
    },

    "power-profiles-daemon": {
      "format": "[ {icon} ]",
      "tooltip-format": "Power profile: {profile}\nDriver: {driver}",
      "tooltip": true,
      "format-icons": {
        "default": "per",
        "performance": "per",
        "balanced": "bal",
        "power-saver": "sav"
      }
    },
    "network": {
        // "interface": "wlp2*", // (Optional) To force the use of this interface
        "format-wifi": "[ wlan: {essid} {signalStrength}% ]",
        "format-ethernet": "[ lan: {ipaddr}/{cidr} ]",
        "tooltip-format": "{ifname} via {gwaddr}",
        "format-linked": "[ {ifname} (No IP) ]",
        "format-disconnected": "[ disconnected ]",
        "format-alt": "[ {ifname}: {ipaddr}/{cidr} ]"
    },
    "pulseaudio": {
        // "scroll-step": 1, // %, can be a float
        "format": "[ {volume}% vol --- {format_source} ]",
        "format-muted": "muted {format_source}",
        "format-source": "{volume}% mic",
        "format-source-muted": "mic muted",
        "on-click": "pavucontrol"
    }
}
